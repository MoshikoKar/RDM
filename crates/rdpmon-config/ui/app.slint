import { Button, CheckBox, ComboBox, LineEdit, TextEdit, ScrollView, Palette } from "std-widgets.slint";

component Row inherits HorizontalLayout {
    in property <string> label;
    spacing: 12px;
    Text {
        text: root.label;
        width: 200px;
        vertical-alignment: center;
        wrap: word-wrap;
    }
    @children
}

component Section inherits Text {
    font-size: 15px;
    font-weight: 600;
}

component Hint inherits Text {
    font-size: 12px;
    wrap: word-wrap;
    color: Palette.foreground.transparentize(40%);
}

component NavItem inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback clicked;
    height: 36px;
    border-radius: 6px;
    background: root.active ? Palette.accent-background.transparentize(80%) : ta.has-hover ? Palette.background.transparentize(40%) : transparent;
    Text {
        x: 14px;
        height: parent.height;
        text: root.label;
        vertical-alignment: center;
        font-weight: root.active ? 600 : 400;
    }
    ta := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

export component AppWindow inherits Window {
    title: "RDP Monitor Configuration";
    icon: @image-url("../../../assets/rdpmon.png");
    preferred-width: 960px;
    preferred-height: 680px;
    min-width: 780px;
    min-height: 540px;
    background: Palette.background;
    default-font-size: 13px;

    // 0 = message/retry, 1 = sign in, 2 = main, 3 = first-run setup
    in-out property <int> screen: 0;
    in-out property <int> page: 0;
    in-out property <int> setup-step: 0;
    in-out property <bool> busy: false;
    in-out property <string> message: "Connecting to the RDP Monitor service...";
    in-out property <bool> message-error: false;

    // status
    in-out property <string> version;
    in-out property <string> hostname;
    in-out property <string> service-state;
    in-out property <string> monitoring-text;
    in-out property <string> queue-text;
    in-out property <string> last-connection;
    in-out property <string> last-error;
    in-out property <string> notification-summary;
    in-out property <string> history-text;

    // sign-in / passwords
    in-out property <string> login-password;
    in-out property <string> current-password;
    in-out property <string> new-password;
    in-out property <string> confirm-password;
    in-out property <string> uninstall-password;

    // email
    in-out property <string> smtp-host;
    in-out property <string> smtp-port: "25";
    in-out property <int> smtp-encryption: 0;
    in-out property <string> smtp-user;
    in-out property <string> smtp-password;
    in-out property <bool> has-smtp-password;
    in-out property <string> mail-from;
    in-out property <string> mail-to;
    in-out property <string> mail-cc;
    in-out property <string> mail-bcc;
    in-out property <string> subject-format;

    // monitoring
    in-out property <bool> notify-new: true;
    in-out property <bool> notify-reconnect: true;
    in-out property <bool> notify-disconnect: false;
    in-out property <bool> notify-logoff: false;
    in-out property <string> cooldown: "15";
    in-out property <bool> security-log: true;
    in-out property <bool> lsm-log: true;
    in-out property <bool> auth-log: true;
    in-out property <bool> ignore-loopback: false;
    in-out property <string> recovery-hours: "168";
    in-out property <bool> failed-enabled: false;
    in-out property <string> failed-threshold: "5";
    in-out property <string> failed-window: "5";
    in-out property <bool> smb-enabled: false;
    in-out property <bool> smb-success: true;
    in-out property <bool> smb-failed: true;
    in-out property <bool> smb-admin-only: false;
    in-out property <string> smb-exclude;
    in-out property <string> history-days: "365";
    in-out property <bool> report-enabled: true;
    in-out property <int> report-day: 0;
    in-out property <string> report-time: "08:00";
    in-out property <string> report-recipients;
    in-out property <bool> hb-enabled: false;
    in-out property <string> hb-time: "08:00";
    in-out property <bool> hb-recovery: false;

    // security
    in-out property <string> trusted-key;
    in-out property <bool> harden: true;
    in-out property <string> audit-text;

    // updates
    in-out property <int> update-provider: 0;
    in-out property <string> repo-url;
    in-out property <string> update-token;
    in-out property <bool> has-update-token;
    in-out property <string> signing-key;
    in-out property <string> update-latest;
    in-out property <string> update-notes;
    in-out property <string> update-message;
    in-out property <bool> update-available;

    callback refresh();
    callback login();
    callback logout();
    callback save();
    callback test-email();
    callback change-password();
    callback restart-monitoring();
    callback authorize-uninstall();
    callback uninstall-now();
    callback load-audit();
    callback check-updates();
    callback install-update();
    callback setup-finish();

    property <color> err-color: #d13438;
    property <color> ok-color: #2e8540;

    VerticalLayout {
        // ---------------------------------------------------------- message
        if root.screen == 0: VerticalLayout {
            alignment: center;
            padding: 40px;
            spacing: 16px;
            Text {
                text: "RDP Monitor";
                font-size: 24px;
                font-weight: 600;
                horizontal-alignment: center;
            }
            Text {
                text: root.message;
                wrap: word-wrap;
                horizontal-alignment: center;
                color: root.message-error ? root.err-color : Palette.foreground;
            }
            HorizontalLayout {
                alignment: center;
                Button {
                    text: "Retry";
                    enabled: !root.busy;
                    clicked => {
                        root.refresh();
                    }
                }
            }
        }

        // ---------------------------------------------------------- sign in
        if root.screen == 1: VerticalLayout {
            alignment: center;
            HorizontalLayout {
                alignment: center;
                VerticalLayout {
                    width: 380px;
                    spacing: 12px;
                    Text {
                        text: "RDP Monitor";
                        font-size: 24px;
                        font-weight: 600;
                    }
                    Hint {
                        text: "Computer: " + root.hostname + "    Version: " + root.version;
                    }
                    Text {
                        text: "Enter the administration password to view and change settings.";
                        wrap: word-wrap;
                    }
                    LineEdit {
                        input-type: password;
                        placeholder-text: "Administration password";
                        text <=> root.login-password;
                        accepted => {
                            root.login();
                        }
                    }
                    Button {
                        text: "Sign in";
                        primary: true;
                        enabled: !root.busy && root.login-password != "";
                        clicked => {
                            root.login();
                        }
                    }
                    Text {
                        text: root.message;
                        wrap: word-wrap;
                        color: root.message-error ? root.err-color : Palette.foreground;
                    }
                }
            }
        }

        // ---------------------------------------------------------- first-run setup
        if root.screen == 3: VerticalLayout {
            padding: 24px;
            spacing: 14px;
            Text {
                text: "Set up RDP Monitor - step " + (root.setup-step + 1) + " of 5";
                font-size: 20px;
                font-weight: 600;
            }
            Hint {
                text: "RDP Monitor is installed and already recording RDP connections on " + root.hostname + ". These steps configure email notifications and protect the settings with a password.";
            }
            Rectangle {
                height: 1px;
                background: Palette.border;
            }
            VerticalLayout {
                vertical-stretch: 1;
                spacing: 12px;
                alignment: start;
                if root.setup-step == 0: VerticalLayout {
                    spacing: 12px;
                    Section {
                        text: "1. Email (SMTP) server";
                    }
                    Hint {
                        text: "Ask your IT department for these values. Leave the server empty to skip email for now.";
                    }
                    Row {
                        label: "SMTP server";
                        LineEdit {
                            text <=> root.smtp-host;
                            placeholder-text: "mail.example.com or 10.0.0.25";
                        }
                    }
                    Row {
                        label: "Port";
                        LineEdit {
                            text <=> root.smtp-port;
                            input-type: number;
                            width: 100px;
                        }
                        Rectangle { }
                    }
                    Row {
                        label: "Encryption";
                        ComboBox {
                            model: ["None (internal relay only)", "STARTTLS (usually port 587)", "TLS / SSL (usually port 465)"];
                            current-index <=> root.smtp-encryption;
                        }
                    }
                    Row {
                        label: "User name (optional)";
                        LineEdit {
                            text <=> root.smtp-user;
                            placeholder-text: "Leave empty if the server needs no sign-in";
                        }
                    }
                    Row {
                        label: "Password";
                        LineEdit {
                            text <=> root.smtp-password;
                            input-type: password;
                            enabled: root.smtp-user != "";
                        }
                    }
                }
                if root.setup-step == 1: VerticalLayout {
                    spacing: 12px;
                    Section {
                        text: "2. Sender and recipients";
                    }
                    Row {
                        label: "Sender address";
                        LineEdit {
                            text <=> root.mail-from;
                            placeholder-text: "rdp-monitor@example.com";
                        }
                    }
                    Row {
                        label: "Recipients";
                        TextEdit {
                            text <=> root.mail-to;
                            height: 70px;
                        }
                    }
                    Hint {
                        text: "One address per line (or separated by commas).";
                    }
                    Row {
                        label: "CC (optional)";
                        LineEdit {
                            text <=> root.mail-cc;
                        }
                    }
                    Row {
                        label: "BCC (optional)";
                        LineEdit {
                            text <=> root.mail-bcc;
                        }
                    }
                }
                if root.setup-step == 2: VerticalLayout {
                    spacing: 12px;
                    Section {
                        text: "3. Monitoring preferences";
                    }
                    CheckBox {
                        text: "Email me about new RDP logins";
                        checked <=> root.notify-new;
                    }
                    CheckBox {
                        text: "Email me about reconnections to existing sessions";
                        checked <=> root.notify-reconnect;
                    }
                    Row {
                        label: "Quiet period (minutes)";
                        LineEdit {
                            text <=> root.cooldown;
                            input-type: number;
                            width: 100px;
                        }
                        Rectangle { }
                    }
                    Hint {
                        text: "After an email about a user connecting from an IP address, further connections by the same user from the same address are not emailed during this period. 0 = email every connection. All connections are always recorded.";
                    }
                    CheckBox {
                        text: "Send a weekly summary report";
                        checked <=> root.report-enabled;
                    }
                    Row {
                        label: "Report day and time";
                        ComboBox {
                            model: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"];
                            current-index <=> root.report-day;
                            enabled: root.report-enabled;
                        }
                        LineEdit {
                            text <=> root.report-time;
                            width: 90px;
                            enabled: root.report-enabled;
                        }
                    }
                }
                if root.setup-step == 3: VerticalLayout {
                    spacing: 12px;
                    Section {
                        text: "4. Administration password";
                    }
                    Hint {
                        text: "This password is required to change any RDP Monitor setting, to update it and to authorize its removal. At least 10 characters, using three of: lowercase, uppercase, digits, symbols.";
                    }
                    Row {
                        label: "Password";
                        LineEdit {
                            text <=> root.new-password;
                            input-type: password;
                        }
                    }
                    Row {
                        label: "Confirm password";
                        LineEdit {
                            text <=> root.confirm-password;
                            input-type: password;
                        }
                    }
                }
                if root.setup-step == 4: VerticalLayout {
                    spacing: 12px;
                    Section {
                        text: "5. Test and finish";
                    }
                    Hint {
                        text: root.smtp-host == "" ? "No email server was entered: connections will be recorded but no email will be sent until you configure one." : "Send a test message to " + root.mail-to + " to confirm email works, then click Finish.";
                    }
                    HorizontalLayout {
                        alignment: start;
                        Button {
                            text: "Send test email";
                            enabled: !root.busy && root.smtp-host != "";
                            clicked => {
                                root.test-email();
                            }
                        }
                    }
                }
            }
            Text {
                text: root.message;
                wrap: word-wrap;
                color: root.message-error ? root.err-color : root.ok-color;
            }
            HorizontalLayout {
                spacing: 10px;
                alignment: end;
                Button {
                    text: "Back";
                    enabled: root.setup-step > 0 && !root.busy;
                    clicked => {
                        root.setup-step -= 1;
                        root.message = "";
                    }
                }
                if root.setup-step < 4: Button {
                    text: "Next";
                    primary: true;
                    clicked => {
                        root.setup-step += 1;
                        root.message = "";
                    }
                }
                if root.setup-step == 4: Button {
                    text: "Finish";
                    primary: true;
                    enabled: !root.busy;
                    clicked => {
                        root.setup-finish();
                    }
                }
            }
        }

        // ---------------------------------------------------------- main
        if root.screen == 2: HorizontalLayout {
            Rectangle {
                width: 200px;
                background: Palette.alternate-background;
                VerticalLayout {
                    padding: 12px;
                    spacing: 4px;
                    Text {
                        text: "RDP Monitor";
                        font-size: 18px;
                        font-weight: 600;
                    }
                    Hint {
                        text: root.hostname;
                    }
                    Rectangle {
                        height: 12px;
                    }
                    NavItem {
                        label: "General";
                        active: root.page == 0;
                        clicked => {
                            root.page = 0;
                        }
                    }
                    NavItem {
                        label: "Email";
                        active: root.page == 1;
                        clicked => {
                            root.page = 1;
                        }
                    }
                    NavItem {
                        label: "Monitoring";
                        active: root.page == 2;
                        clicked => {
                            root.page = 2;
                        }
                    }
                    NavItem {
                        label: "Security";
                        active: root.page == 3;
                        clicked => {
                            root.page = 3;
                            root.load-audit();
                        }
                    }
                    NavItem {
                        label: "Updates";
                        active: root.page == 4;
                        clicked => {
                            root.page = 4;
                        }
                    }
                    Rectangle {
                        vertical-stretch: 1;
                    }
                    Button {
                        text: "Sign out";
                        clicked => {
                            root.logout();
                        }
                    }
                }
            }

            VerticalLayout {
                horizontal-stretch: 1;
                sv := ScrollView {
                    vertical-stretch: 1;
                    content-height: content.preferred-height;
                    content := VerticalLayout {
                        width: sv.visible-width;
                        padding: 22px;
                        spacing: 12px;
                        alignment: start;

                        // ---------------- General
                        if root.page == 0: VerticalLayout {
                            spacing: 10px;
                            Section {
                                text: "Status";
                            }
                            Row {
                                label: "Installed version";
                                Text {
                                    text: root.version;
                                }
                            }
                            Row {
                                label: "Computer";
                                Text {
                                    text: root.hostname;
                                }
                            }
                            Row {
                                label: "Service";
                                Text {
                                    text: root.service-state;
                                }
                            }
                            Row {
                                label: "Monitoring";
                                Text {
                                    text: root.monitoring-text;
                                    wrap: word-wrap;
                                }
                            }
                            Row {
                                label: "Notification queue";
                                Text {
                                    text: root.queue-text;
                                }
                            }
                            Row {
                                label: "Last RDP connection";
                                Text {
                                    text: root.last-connection;
                                }
                            }
                            if root.last-error != "": Row {
                                label: "Last problem";
                                Text {
                                    text: root.last-error;
                                    wrap: word-wrap;
                                    color: root.err-color;
                                }
                            }
                            Section {
                                text: "Notification settings";
                            }
                            Text {
                                text: root.notification-summary;
                                wrap: word-wrap;
                            }
                            HorizontalLayout {
                                spacing: 10px;
                                alignment: start;
                                Button {
                                    text: "Refresh";
                                    enabled: !root.busy;
                                    clicked => {
                                        root.refresh();
                                    }
                                }
                                Button {
                                    text: "Restart monitoring";
                                    enabled: !root.busy;
                                    clicked => {
                                        root.restart-monitoring();
                                    }
                                }
                            }
                            Section {
                                text: "Recent connections";
                            }
                            TextEdit {
                                text: root.history-text;
                                read-only: true;
                                height: 220px;
                                font-size: 12px;
                            }
                        }

                        // ---------------- Email
                        if root.page == 1: VerticalLayout {
                            spacing: 10px;
                            Section {
                                text: "SMTP server";
                            }
                            Row {
                                label: "SMTP server";
                                LineEdit {
                                    text <=> root.smtp-host;
                                    placeholder-text: "mail.example.com or 10.0.0.25";
                                }
                            }
                            Row {
                                label: "Port";
                                LineEdit {
                                    text <=> root.smtp-port;
                                    input-type: number;
                                    width: 100px;
                                }
                                Rectangle { }
                            }
                            Row {
                                label: "Encryption";
                                ComboBox {
                                    model: ["None (internal relay only)", "STARTTLS (usually port 587)", "TLS / SSL (usually port 465)"];
                                    current-index <=> root.smtp-encryption;
                                }
                            }
                            Row {
                                label: "User name (optional)";
                                LineEdit {
                                    text <=> root.smtp-user;
                                    placeholder-text: "Leave empty if the server needs no sign-in";
                                }
                            }
                            Row {
                                label: "Password";
                                LineEdit {
                                    text <=> root.smtp-password;
                                    input-type: password;
                                    enabled: root.smtp-user != "";
                                    placeholder-text: root.has-smtp-password ? "Saved - leave empty to keep it" : "";
                                }
                            }
                            Section {
                                text: "Sender and recipients";
                            }
                            Row {
                                label: "Sender address";
                                LineEdit {
                                    text <=> root.mail-from;
                                }
                            }
                            Row {
                                label: "Recipients";
                                TextEdit {
                                    text <=> root.mail-to;
                                    height: 70px;
                                }
                            }
                            Row {
                                label: "CC";
                                LineEdit {
                                    text <=> root.mail-cc;
                                }
                            }
                            Row {
                                label: "BCC";
                                LineEdit {
                                    text <=> root.mail-bcc;
                                }
                            }
                            Row {
                                label: "Subject format";
                                LineEdit {
                                    text <=> root.subject-format;
                                }
                            }
                            Hint {
                                text: "Recipients: one per line or comma separated. Subject placeholders: {user} {domain} {ip} {host} {type} {time}";
                            }
                            HorizontalLayout {
                                alignment: start;
                                Button {
                                    text: "Send test email";
                                    enabled: !root.busy;
                                    clicked => {
                                        root.test-email();
                                    }
                                }
                            }
                            Hint {
                                text: "The test uses the values shown above, even before you click Save.";
                            }
                        }

                        // ---------------- Monitoring
                        if root.page == 2: VerticalLayout {
                            spacing: 10px;
                            Section {
                                text: "Windows events";
                            }
                            CheckBox {
                                text: "Security log: logon 4624 (type 10), reconnect 4778, disconnect 4779";
                                checked <=> root.security-log;
                            }
                            CheckBox {
                                text: "Session Manager log: logon 21, disconnect 24, reconnect 25";
                                checked <=> root.lsm-log;
                            }
                            CheckBox {
                                text: "Remote Connection Manager log: authentication 1149 (supporting evidence only)";
                                checked <=> root.auth-log;
                            }
                            CheckBox {
                                text: "Ignore connections from this computer (127.0.0.1 / ::1 - not recommended: tunnelled RDP appears as loopback)";
                                checked <=> root.ignore-loopback;
                            }
                            Section {
                                text: "Notifications";
                            }
                            CheckBox {
                                text: "Email about new RDP logins";
                                checked <=> root.notify-new;
                            }
                            CheckBox {
                                text: "Email about reconnections";
                                checked <=> root.notify-reconnect;
                            }
                            CheckBox {
                                text: "Email when a session is disconnected (with session duration)";
                                checked <=> root.notify-disconnect;
                            }
                            CheckBox {
                                text: "Email when a user logs off (Session Manager 23, with session duration)";
                                checked <=> root.notify-logoff;
                            }
                            Row {
                                label: "Quiet period (minutes)";
                                LineEdit {
                                    text <=> root.cooldown;
                                    input-type: number;
                                    width: 100px;
                                }
                                Rectangle { }
                            }
                            Hint {
                                text: "The same account (domain and user) from the same IP is emailed at most once per quiet period. 0 = email every distinct connection.";
                            }
                            Section {
                                text: "Failed logons";
                            }
                            CheckBox {
                                text: "Email when one IP fails to log on repeatedly (Security 4625, network and remote desktop logons)";
                                checked <=> root.failed-enabled;
                            }
                            Row {
                                label: "Failures / within minutes";
                                LineEdit {
                                    text <=> root.failed-threshold;
                                    input-type: number;
                                    width: 100px;
                                    enabled: root.failed-enabled;
                                }
                                LineEdit {
                                    text <=> root.failed-window;
                                    input-type: number;
                                    width: 100px;
                                    enabled: root.failed-enabled;
                                }
                                Rectangle { }
                            }
                            Hint {
                                text: "Needs 'Audit Logon' failure auditing (on by default). With NLA a wrong RDP password is a network (type 3) logon, so file-share and other network logon failures are counted too. One email per IP per quiet period (at least the counting window).";
                            }
                            Section {
                                text: "Shared folders (SMB)";
                            }
                            CheckBox {
                                text: "Monitor access to this computer's shared folders (C$, ADMIN$ and regular shares)";
                                checked <=> root.smb-enabled;
                            }
                            CheckBox {
                                text: "Email on successful access (5140, once per session per share)";
                                checked <=> root.smb-success;
                                enabled: root.smb-enabled;
                            }
                            CheckBox {
                                text: "Email on denied access (5145) and failed network logons (4625, using the failed logon threshold)";
                                checked <=> root.smb-failed;
                                enabled: root.smb-enabled;
                            }
                            CheckBox {
                                text: "Only admin shares (names ending in $)";
                                checked <=> root.smb-admin-only;
                                enabled: root.smb-enabled;
                            }
                            Row {
                                label: "Never email these shares";
                                LineEdit {
                                    text <=> root.smb-exclude;
                                    placeholder-text: "e.g. IPC$, print$ (still recorded in history)";
                                    enabled: root.smb-enabled;
                                }
                            }
                            Hint {
                                text: "Needs auditing on this computer: auditpol /set /subcategory:\"File Share\" /success:enable, /subcategory:\"Detailed File Share\" /failure:enable (never success: very noisy), /subcategory:\"Logon\" /failure:enable. The status page warns when one is off.";
                            }
                            Section {
                                text: "History";
                            }
                            Row {
                                label: "Keep history (days)";
                                LineEdit {
                                    text <=> root.history-days;
                                    input-type: number;
                                    width: 100px;
                                }
                                Rectangle { }
                            }
                            Row {
                                label: "Recover missed events (hours)";
                                LineEdit {
                                    text <=> root.recovery-hours;
                                    input-type: number;
                                    width: 100px;
                                }
                                Rectangle { }
                            }
                            Section {
                                text: "Weekly report";
                            }
                            CheckBox {
                                text: "Send a weekly report";
                                checked <=> root.report-enabled;
                            }
                            Row {
                                label: "Day and time";
                                ComboBox {
                                    model: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"];
                                    current-index <=> root.report-day;
                                    enabled: root.report-enabled;
                                }
                                LineEdit {
                                    text <=> root.report-time;
                                    width: 90px;
                                    enabled: root.report-enabled;
                                }
                            }
                            Row {
                                label: "Report recipients";
                                LineEdit {
                                    text <=> root.report-recipients;
                                    placeholder-text: "Empty = same as notification recipients";
                                    enabled: root.report-enabled;
                                }
                            }
                            Section {
                                text: "Health";
                            }
                            CheckBox {
                                text: "Send a daily heartbeat email (agent version, event channels, queue)";
                                checked <=> root.hb-enabled;
                            }
                            Row {
                                label: "Heartbeat time";
                                LineEdit {
                                    text <=> root.hb-time;
                                    width: 90px;
                                    enabled: root.hb-enabled;
                                }
                                Rectangle { }
                            }
                            CheckBox {
                                text: "After an email outage, send one summary of delayed and dropped alerts";
                                checked <=> root.hb-recovery;
                            }
                        }

                        // ---------------- Security
                        if root.page == 3: VerticalLayout {
                            spacing: 10px;
                            Section {
                                text: "Change administration password";
                            }
                            Row {
                                label: "Current password";
                                LineEdit {
                                    text <=> root.current-password;
                                    input-type: password;
                                }
                            }
                            Row {
                                label: "New password";
                                LineEdit {
                                    text <=> root.new-password;
                                    input-type: password;
                                }
                            }
                            Row {
                                label: "Confirm new password";
                                LineEdit {
                                    text <=> root.confirm-password;
                                    input-type: password;
                                }
                            }
                            HorizontalLayout {
                                alignment: start;
                                Button {
                                    text: "Change password";
                                    enabled: !root.busy && root.current-password != "" && root.new-password != "";
                                    clicked => {
                                        root.change-password();
                                    }
                                }
                            }
                            Section {
                                text: "Protection";
                            }
                            CheckBox {
                                text: "Prevent Administrators from stopping or deleting the service through Windows (recommended)";
                                checked <=> root.harden;
                            }
                            Row {
                                label: "Trusted configuration key";
                                LineEdit {
                                    text <=> root.trusted-key;
                                    placeholder-text: "Base64 Ed25519 public key for signed configuration packages";
                                }
                            }
                            Hint {
                                text: "Windows Administrators keep ultimate control of this computer. These measures protect RDP Monitor's own management workflows; see the documentation for their limits.";
                            }
                            Section {
                                text: "Remove RDP Monitor";
                            }
                            Hint {
                                text: "Enter the administration password to stop the RDPMonitor service and uninstall the application. This window closes and Windows Installer shows the removal progress. You can also authorize removal and then use Settings > Apps within 10 minutes.";
                            }
                            Row {
                                label: "Admin password";
                                LineEdit {
                                    text <=> root.uninstall-password;
                                    input-type: password;
                                    placeholder-text: "Administration password";
                                }
                            }
                            HorizontalLayout {
                                alignment: start;
                                spacing: 8px;
                                Button {
                                    text: "Uninstall now";
                                    enabled: !root.busy && root.uninstall-password != "";
                                    clicked => {
                                        root.uninstall-now();
                                    }
                                }
                                Button {
                                    text: "Authorize uninstall only";
                                    enabled: !root.busy;
                                    clicked => {
                                        root.authorize-uninstall();
                                    }
                                }
                            }
                            Section {
                                text: "Administrative action history";
                            }
                            TextEdit {
                                text: root.audit-text;
                                read-only: true;
                                height: 220px;
                                font-size: 12px;
                            }
                        }

                        // ---------------- Updates
                        if root.page == 4: VerticalLayout {
                            spacing: 10px;
                            Section {
                                text: "Application updates";
                            }
                            Row {
                                label: "Installed version";
                                Text {
                                    text: root.version;
                                }
                            }
                            Row {
                                label: "Update source";
                                ComboBox {
                                    model: ["Not configured", "GitHub Releases", "GitLab Releases"];
                                    current-index <=> root.update-provider;
                                }
                            }
                            Row {
                                label: "Repository URL";
                                LineEdit {
                                    text <=> root.repo-url;
                                    placeholder-text: "https://github.com/org/rdp-monitor";
                                }
                            }
                            Row {
                                label: "Access token (private)";
                                LineEdit {
                                    text <=> root.update-token;
                                    input-type: password;
                                    placeholder-text: root.has-update-token ? "Saved - leave empty to keep it" : "Only for private repositories";
                                }
                            }
                            Row {
                                label: "Update signing key";
                                LineEdit {
                                    text <=> root.signing-key;
                                    placeholder-text: "Base64 Ed25519 public key";
                                }
                            }
                            Hint {
                                text: "Save changes to these settings before checking. Updates are only checked when you click the button below, and only packages signed with the update signing key are installed.";
                            }
                            HorizontalLayout {
                                spacing: 10px;
                                alignment: start;
                                Button {
                                    text: "Check for updates";
                                    enabled: !root.busy;
                                    clicked => {
                                        root.check-updates();
                                    }
                                }
                                Button {
                                    text: "Download and install " + root.update-latest;
                                    primary: true;
                                    visible: root.update-available;
                                    enabled: !root.busy && root.update-available;
                                    clicked => {
                                        root.install-update();
                                    }
                                }
                            }
                            Text {
                                text: root.update-message;
                                wrap: word-wrap;
                            }
                            if root.update-notes != "": TextEdit {
                                text: root.update-notes;
                                read-only: true;
                                height: 200px;
                                font-size: 12px;
                            }
                        }
                    }
                }
                Rectangle {
                    height: 1px;
                    background: Palette.border;
                }
                HorizontalLayout {
                    padding: 12px;
                    spacing: 12px;
                    Text {
                        text: root.message;
                        wrap: word-wrap;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        color: root.message-error ? root.err-color : root.ok-color;
                    }
                    Button {
                        text: root.busy ? "Working..." : "Save";
                        primary: true;
                        enabled: !root.busy;
                        clicked => {
                            root.save();
                        }
                    }
                }
            }
        }
    }
}
