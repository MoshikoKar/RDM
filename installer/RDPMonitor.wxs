<?xml version="1.0" encoding="utf-8"?>
<!--
  RDP Monitor MSI (WiX Toolset v5).

  Public properties (all optional):
    TRUSTED_CONFIG_KEY  Base64 Ed25519 public key trusted for signed configuration
                        packages. Honoured only on a computer that has no trusted key yet.
    CONFIG_PACKAGE      Path to a signed .rdpcfg package applied during installation.

  Neither property carries a secret. Never pass passwords on the msiexec command line.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="RDP Monitor"
           Manufacturer="RDP Monitor"
           Version="$(var.Version)"
           UpgradeCode="56E6081C-56F2-4289-93C3-A252863CFC91"
           Scope="perMachine"
           Compressed="yes">

    <SummaryInformation Description="RDP Monitor - Remote Desktop connection monitoring agent" />

    <!-- Remove the old version inside the same transaction: a failed upgrade
         rolls back to the previous version. Downgrades are refused. -->
    <MajorUpgrade Schedule="afterInstallInitialize"
                  DowngradeErrorMessage="A newer version of RDP Monitor is already installed. Downgrades are not allowed." />
    <MediaTemplate EmbedCab="yes" />

    <Launch Condition="VersionNT64" Message="RDP Monitor requires 64-bit Windows." />
    <Launch Condition="Privileged" Message="RDP Monitor must be installed by an administrator." />

    <!-- ARPNOMODIFY=1 is set by WixUI_Minimal. -->
    <Property Id="ARPCOMMENTS" Value="Monitors Remote Desktop connections and sends email notifications." />
    <Property Id="TRUSTED_CONFIG_KEY" Secure="yes" />
    <Property Id="CONFIG_PACKAGE" Secure="yes" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="RDP Monitor" />
    </StandardDirectory>

    <ComponentGroup Id="Product" Directory="INSTALLFOLDER">
      <Component Id="ServiceComponent" Bitness="always64">
        <File Id="SvcExe" Source="$(var.BinDir)\rdpmon-svc.exe" KeyPath="yes" />
        <ServiceInstall Id="ServiceInstall"
                        Name="RDPMonitor"
                        DisplayName="RDP Monitor"
                        Description="Monitors Remote Desktop (RDP) connections and sends email notifications."
                        Type="ownProcess"
                        Start="auto"
                        ErrorControl="normal"
                        Account="LocalSystem"
                        Arguments="service"
                        Vital="yes" />
        <ServiceControl Id="ServiceControl" Name="RDPMonitor" Start="install" Stop="both" Remove="uninstall" Wait="yes" />
      </Component>
      <Component Id="ConfigComponent" Bitness="always64">
        <File Id="ConfigExe" Source="$(var.BinDir)\rdpmon-config.exe" KeyPath="yes">
          <Shortcut Id="ConfigShortcut"
                    Directory="ProgramMenuFolder"
                    Name="RDP Monitor Configuration"
                    Description="Configure RDP Monitor"
                    WorkingDirectory="INSTALLFOLDER"
                    Advertise="yes" />
        </File>
      </Component>
      <Component Id="DocsComponent" Bitness="always64">
        <File Id="Readme" Source="$(var.DocDir)\README.md" KeyPath="yes" />
      </Component>
      <Component Id="UninstallPs1Component" Bitness="always64">
        <File Id="UninstallPs1" Source="$(var.DocDir)\scripts\deploy\Uninstall-RDPMonitor.ps1" KeyPath="yes" />
      </Component>
      <Component Id="UninstallCmdComponent" Bitness="always64">
        <File Id="UninstallCmd" Source="$(var.InstallerDir)\uninstall.cmd" KeyPath="yes">
          <Shortcut Id="UninstallShortcut"
                    Directory="ProgramMenuFolder"
                    Name="Uninstall RDP Monitor"
                    Description="Enter the administration password to stop RDP Monitor and uninstall"
                    WorkingDirectory="INSTALLFOLDER"
                    Advertise="yes" />
        </File>
      </Component>
    </ComponentGroup>

    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main" Title="RDP Monitor" AllowAbsent="no">
      <ComponentGroupRef Id="Product" />
    </Feature>

    <!-- Provisioning: runs as LocalSystem after the files are installed and
         before the service starts. Output is written to the MSI log
         (WixQuietExec) and to C:\ProgramData\RDP Monitor\logs\service.log. -->
    <SetProperty Id="ProvisionAgent"
                 Value="&quot;[#SvcExe]&quot; provision --trusted-key &quot;[TRUSTED_CONFIG_KEY]&quot; --package &quot;[CONFIG_PACKAGE]&quot;"
                 Before="ProvisionAgent" Sequence="execute" />
    <CustomAction Id="ProvisionAgent" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec"
                  Execute="deferred" Impersonate="no" Return="check" />

    <!-- Removal must be authorized in the configuration utility (password
         protected). Not evaluated when an upgrade removes the old version. -->
    <SetProperty Id="CheckUninstall"
                 Value="&quot;[#SvcExe]&quot; uninstall-check"
                 Before="CheckUninstall" Sequence="execute" />
    <CustomAction Id="CheckUninstall" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec"
                  Execute="deferred" Impersonate="no" Return="check" />

    <InstallExecuteSequence>
      <Custom Action="CheckUninstall" Before="StopServices"
              Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="ProvisionAgent" Before="StartServices"
              Condition="NOT REMOVE~=&quot;ALL&quot;" />
    </InstallExecuteSequence>

    <!-- Interactive installation: after the files are installed the Finish
         page offers to open the setup wizard (email, recipients, monitoring
         preferences, administration password, test email). No secret ever
         passes through MSI properties or logs. -->
    <WixVariable Id="WixUILicenseRtf" Value="$(var.InstallerDir)\license.rtf" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Open the RDP Monitor setup wizard now" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[#ConfigExe]" />
    <CustomAction Id="LaunchSetupWizard" BinaryRef="Wix4UtilCA_X64" DllEntry="WixShellExec" Impersonate="yes" />
    <UI>
      <ui:WixUI Id="WixUI_Minimal" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchSetupWizard"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>
  </Package>
</Wix>
